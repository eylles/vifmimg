#!/bin/sh

FILE="$PWD/$6"
# 1024
CacheDim=1024
# ${CacheDim}x${CacheDim} = 1024x1024
CxC="${CacheDim}x${CacheDim}"
CacheBaseDir="${XDG_CACHE_HOME:-$HOME/.cache}/thumbnails"
CacheX="${CacheBaseDir}/xx-large"
CacheDir="$CacheX"

if [ ! -d "$CacheDir" ]; then
  mkdir -p "$CacheDir"
fi

get_max() {
  if [ "$1" -gt "$2" ]; then
    echo "$1"
  else
    echo "$2"
  fi
}

get_min() {
  if [ "$1" -lt "$2" ]; then
    echo "$1"
  else
    echo "$2"
  fi
}

get_thumbnail_name () {
    filepath=$(realpath "$1")
    perl -MURI::file -MDigest::MD5=md5_hex \
        -e 'printf "%s.png\n", md5_hex(URI::file->new(shift))' "$filepath"
}

get_max_img_dim () {
    ImgDims=$(identify -quiet -precision 3 -format '%wx%h\n' "$1" 2>/dev/null)
    [ -z "$ImgDims" ] && ImgDims=$(identify -quiet -precision 3 "$1" 2>/dev/null | awk '{ print $3 }')
    ImgW="${ImgDims%%x*}"
    ImgH="${ImgDims##*x}"
    ImgPixRes=$(get_max "$ImgW" "$ImgH")
    echo "$ImgPixRes"
}

ThumbName=$(get_thumbnail_name "$FILE")
PCACHE="${CacheDir}/${ThumbName}"
PROPS_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/vifmimg"
[ ! -d "$PROPS_CACHE_DIR" ] && mkdir -p "$PROPS_CACHE_DIR"
PROPS_CACHE="${PROPS_CACHE_DIR}/${ThumbName%%.png}.txt"

export PCACHE

# Type: int
# value: 0
_true=0
# Type: int
# value: 1
_false=1

check_cache() {
    # check if cache file exists
    [ ! -f "$1" ] && return "$_false"
    
    # Check if original file is newer than cache
    [ "$FILE" -nt "$1" ] && return "$_false"
    
    return "$_true"
}

pclear() {
	printf '{"action": "remove", "identifier": "vifm-preview"}\n' > "$FIFO_UEBERZUG"
}

image_margin_top() {
    Y=$3
    if [ -n "$VIM" ] || [ -n "$NVIM" ]; then
        Y=$(( Y + 2 ))
    fi
		printf '{"action": "add", "identifier": "vifm-preview", "x": "%s", "y": "%s", "width": "%s", "height": "%s", "scaler": "contain", "path": "%s"}\n' "$2" "$(( Y + 2 ))" "$4" "$(( $5 - 2 ))" "$6" > "$FIFO_UEBERZUG"
}

image() {
    Y=$3
    if [ -n "$VIM" ] || [ -n "$NVIM" ]; then
        Y=$(( Y + 1 ))
    fi
		printf '{"action": "add", "identifier": "vifm-preview", "x": "%s", "y": "%s", "width": "%s", "height": "%s", "scaler": "contain", "path": "%s"}\n' "$2" "$Y" "$4" "$5" "$6" > "$FIFO_UEBERZUG"
}

img_props() {
    if check_cache "$PROPS_CACHE"; then
        cat "$PROPS_CACHE"
    else
        identify -quiet -precision 3 -format '%w %h %e %b %f\n' "$1"'[0]' 2>/dev/null | \
            awk '{
                    a=$1; b=$2;
                    while(b){ t=b; b=a%b; a=t; }
                        printf "%s %dx%d(%d:%d) %s %s \n", $3, $1, $2, $1/a, $2/a, $4, $5
                }' | tee "$PROPS_CACHE"
    fi
}

main() {
    case "$1" in
        "clear")
			pclear "$@"
			;;
        "draw")
            case "$(realpath "$PWD")" in
                *"$CacheBaseDir"*)
                    image_margin_top "$1" "$2" "$3" "$4" "$5" "$FILE" &
                    ;;
                *)
                    if check_cache "$PCACHE"; then
                        image_margin_top "$1" "$2" "$3" "$4" "$5" "$PCACHE" &
                    else
                        ImgRes=$(get_max_img_dim "$FILE")
                        if [ "$ImgRes" -lt "$CacheDim" ]; then
                            image_margin_top "$1" "$2" "$3" "$4" "$5" "$FILE" &
                        else
                            convert "$FILE"'[0]' -resize "$CxC" "$PCACHE" 2>/dev/null
                            image_margin_top "$1" "$2" "$3" "$4" "$5" "$FILE" &
                        fi
                    fi
                    ;;
            esac
            img_props "$FILE" &
			;;
        "svg")
			if ! check_cache "$PCACHE"; then convert -background none "$6" "${PCACHE}"; fi
			image_margin_top "$1" "$2" "$3" "$4" "$5" "${PCACHE}" &
			img_props "$FILE" &

			;;
        "video")
			if ! check_cache "$PCACHE"; then ffmpegthumbnailer -i "$6" -o "${PCACHE}" -s "$CacheDim" -q 5; fi
			image "$1" "$2" "$3" "$4" "$5" "${PCACHE}"
			;;
        "epub")
			if ! check_cache "$PCACHE"; then epub-thumbnailer "$6" "$PCACHE" "$CacheDim" ;fi
			image "$1" "$2" "$3" "$4" "$5" "$PCACHE"
			;;
        "pdf")
			if ! check_cache "$PCACHE"; then
                pdftoppm -png -f 1 -singlefile -scale-to "$CacheDim" "$6" "${PCACHE%%.png}" 
            fi
			image "$1" "$2" "$3" "$4" "$5" "${PCACHE}"
			;;
        "djvu")
			if ! check_cache "$PCACHE"; then ddjvu -format=png -quality=90 -page=1 "$6" "$PCACHE" ;fi
			image "$1" "$2" "$3" "$4" "$5" "${PCACHE}"
			;;
        "audio")
			if ! check_cache "$PCACHE"; then ffmpeg -hide_banner -i "$6" "${PCACHE}" -y >/dev/null ;fi
			image "$1" "$2" "$3" "$4" "$5" "${PCACHE}"
			;;
        "font")
			if ! check_cache "$PCACHE"; then fontpreview --size "$CxC" -i "$6" -o "${PCACHE}" ;fi
			image "$1" "$2" "$3" "$4" "$5" "${PCACHE}"
			;;
        *)
    esac
}
main "$@"
